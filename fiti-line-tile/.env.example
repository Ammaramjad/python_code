# SQLite file. npm run setup rewrites .env with an absolute path so Prisma
# and Next resolve the same database. No credentials are required.
DATABASE_URL="file:./data/demo.db"

# Optional LINE Messaging API. Leave disabled for the local demo.
# Simulator traffic never uses these values.
LINE_ENABLED="false"
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# Optional future OCR/multimodal provider. Unset means staff enter markings.
# The app will not invent OCR text for uploads.
OCR_PROVIDER="none"
